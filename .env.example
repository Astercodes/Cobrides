# Set these directly in Vercel, never in public JavaScript.
APP_ORIGIN=https://furbrides.vercel.app
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random value of at least 32 characters. Changing it invalidates stored connections.
INTEGRATION_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
# Start in Stripe test mode. This fixed price belongs to the configured Stripe merchant.
STRIPE_SECRET_KEY=
STRIPE_REGISTRY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional Vision Studio AI assistant. Choose a model available to your API project.
OPENAI_API_KEY=
OPENAI_MODEL=
