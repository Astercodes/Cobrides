{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/offline-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/offline-manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/integrations.js": {
      "maxDuration": 60
    },
    "api/link-preview.js": {
      "maxDuration": 60
    },
    "api/social.js": {
      "maxDuration": 60
    },
    "api/board-import.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/wedding/:slug",
      "destination": "/celebrate.html"
    },
    {
      "source": "/:slug([a-z0-9]+(?:-[a-z0-9]+)*)",
      "destination": "/celebrate.html"
    }
  ]
}
